# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 공개하지 말 것
SUPABASE_SECRET_KEY=

# 사진 AI 피드백 (서버 전용)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# 선택: temperature를 지원하는 모델일 때만. 비워두면 보내지 않는다
OPENAI_TEMPERATURE=

# 연락처 암호화 키 (서버 전용). 32바이트를 base64로. 만들기:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 바꾸거나 잃어버리면 저장된 연락처를 읽을 수 없으니 따로 보관한다
CONTACT_ENCRYPTION_KEY=

# 매일 추천 계산(Vercel Cron) 보호용 비밀값. 만들기:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
