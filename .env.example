# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 공개하지 말 것
SUPABASE_SECRET_KEY=

# 사진 AI 피드백 (서버 전용)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# 선택: temperature를 지원하는 모델일 때만. 비워두면 보내지 않는다
OPENAI_TEMPERATURE=

# 연락처 암호화 키 (서버 전용). 32바이트를 base64로. 만들기:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 바꾸거나 잃어버리면 저장된 연락처를 읽을 수 없으니 따로 보관한다
CONTACT_ENCRYPTION_KEY=

# 매일 추천 계산(Vercel Cron) 보호용 비밀값. 만들기:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# (선택) 관리자 이메일. 쉼표로 여러 개. 비워두면 testwelltest01@gmail.com
ADMIN_EMAILS=

# (선택) 그림 프로필 이미지 모델과 품질. 비워두면 gpt-image-2.5-sunburst, medium
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
# (선택) 서비스 전체에서 하루에 그릴 수 있는 그림 수 (비용 보호). 비워두면 300
ILLUSTRATION_DAILY_CAP=

# (선택) 연애 상황 보고서를 쓰는 글 모델 (Chat Completions + JSON schema 지원). 비워두면 OPENAI_VISION_MODEL
OPENAI_REPORT_MODEL=
# (선택) 서비스 전체에서 하루에 쓸 수 있는 보고서 수 (비용 보호). 비워두면 300
LOVE_REPORT_DAILY_CAP=
# (선택) 그중 가입 전 공유 링크(비회원) 보고서의 하루 상한. 비워두면 100
LOVE_GUEST_DAILY_CAP=

# (선택) 관리자 API 사용량의 원/달러 환율. 비워두면 1324 (2026-10-23)
USD_KRW=
